<Application x:Class="SoftsGarageRemover.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ── Palette ── -->
            <Color x:Key="BgDeep">#0D0D14</Color>
            <Color x:Key="BgPanel">#13131F</Color>
            <Color x:Key="BgCard">#1A1A2A</Color>
            <Color x:Key="BgHover">#222236</Color>
            <Color x:Key="BgSelected">#2A2A44</Color>
            <Color x:Key="Border">#2E2E42</Color>
            <Color x:Key="TextPrimary">#E8E8F0</Color>
            <Color x:Key="TextMuted">#8888A0</Color>
            <Color x:Key="TextDim">#5C5C72</Color>
            <Color x:Key="AccentBlue">#4C9EFF</Color>
            <Color x:Key="AccentGreen">#00E676</Color>
            <Color x:Key="AccentRed">#FF5252</Color>
            <Color x:Key="AccentOrange">#FFAB40</Color>
            <Color x:Key="DupeRed">#FF6B6B</Color>
            <Color x:Key="UniqueGreen">#69DB7C</Color>

            <SolidColorBrush x:Key="BgDeepBrush"    Color="{StaticResource BgDeep}"/>
            <SolidColorBrush x:Key="BgPanelBrush"   Color="{StaticResource BgPanel}"/>
            <SolidColorBrush x:Key="BgCardBrush"     Color="{StaticResource BgCard}"/>
            <SolidColorBrush x:Key="BgHoverBrush"    Color="{StaticResource BgHover}"/>
            <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelected}"/>
            <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource Border}"/>
            <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMuted}"/>
            <SolidColorBrush x:Key="TextDimBrush"    Color="{StaticResource TextDim}"/>
            <SolidColorBrush x:Key="AccentBlueBrush"  Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
            <SolidColorBrush x:Key="AccentRedBrush"   Color="{StaticResource AccentRed}"/>

            <!-- ── Primary button ── -->
            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="Background"  Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Foreground"  Value="White"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Padding"     Value="18,9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Ghost / secondary button ── -->
            <Style x:Key="GhostBtn" TargetType="Button">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="Foreground"  Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="FontSize"    Value="12.5"/>
                <Setter Property="Padding"     Value="14,8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource BgHover}"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Danger button ── -->
            <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource AccentRed}"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
